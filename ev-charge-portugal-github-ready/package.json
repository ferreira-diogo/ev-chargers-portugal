{
  "name": "chargevoy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8080",
    "build:web": "node scripts/build-web.mjs",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android",
    "android:bundle": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "nap:check": "node scripts/import-nap-datex.mjs --dry-run",
    "nap:stage": "node scripts/import-nap-datex.mjs --stage"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/geolocation": "8.1.0",
    "@supabase/supabase-js": "2.116.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
